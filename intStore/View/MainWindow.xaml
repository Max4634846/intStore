<Window x:Class="intStore.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:metro="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:local="clr-namespace:intStore"
        mc:Ignorable="d"
        Title="Login" Height="650" Width="850"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStartupLocation="CenterScreen"
        Icon="\Images\Avocado.png">

    <Border Background="White" CornerRadius="35" MouseDown="Border_MouseDown">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>


            <Image Source="\Images\LoginImage.jpg" Margin="25" VerticalAlignment="Center" />

            <Border Grid.Column="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="650" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TabControl Background="Transparent" BorderBrush="Transparent" Grid.Row="1" Margin="30" x:Name="mainTabControl">
                        <TabItem Header="Авторизация" VerticalAlignment="Center" HorizontalAlignment="Center" x:Name="Author" Visibility="Collapsed">
                            <Border Background="Transparent" CornerRadius="15">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="200" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left" Grid.ColumnSpan="2" Margin="37,0,0,0">
                                        <Image Source="\Images\Avocado.png" Height="64" Width="64" Margin="0 0 0 5"/>
                                        <TextBlock Text="Интернет-Магазин" Foreground="LightGreen" 
                                                            FontSize="36" FontWeight="Bold">
                                            <TextBlock.Effect>
                                                <DropShadowEffect Color="#312563" Direction="180" ShadowDepth="3" BlurRadius="10" Opacity="0.9" />
                                            </TextBlock.Effect>
                                        </TextBlock>
                                    </StackPanel>

                                    <Grid Width="350" HorizontalAlignment="Left" Grid.Row="1" Grid.ColumnSpan="2" Margin="27,0,0,90" Grid.RowSpan="2">
                                        <TextBlock x:Name="searchPlaceholder" Margin="26 0" VerticalAlignment="Center" Foreground="Gray" FontSize="16" FontWeight="Medium" FontFamily="Montserrat"
                                                            IsHitTestVisible="False" Panel.ZIndex="1" Text="Введите почту...">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text.Length, ElementName=txtFilterEmail}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TextBox x:Name="txtFilterEmail" Margin="15 0" VerticalAlignment="Center" Style="{StaticResource TextBoxStyle}" Height="30"/>

                                    </Grid>

                                    <Grid Width="350" HorizontalAlignment="Left" Grid.Row="2" Grid.ColumnSpan="2" Margin="27,0,0,0">
                                        <PasswordBox Name="passwordBox"  Margin="15 0" PasswordChanged="PasswordBox_PasswordChanged" Style="{StaticResource PasswordBoxStyle}" />
                                    </Grid>



                                    <Button Grid.Row="3" Height="35" Width="200" Style="{StaticResource SecondaryButton}" Content="Войти" Click="LoginBtn_Click" Grid.ColumnSpan="2"/>
                                    <Button Grid.Row="3" Content="Регистрация" Background="Transparent" FontSize="10"  Foreground="#33bb5e" BorderThickness="0" Margin="0,68,0,1" Width="60" Click="NextReg_Click"/>
                                </Grid>
                            </Border>
                        </TabItem>

                        <TabItem Header="Регистрация" Background="Transparent" VerticalAlignment="Center" HorizontalAlignment="Center" x:Name="Reg" Visibility="Collapsed" >
                            <Border Background="Transparent" CornerRadius="15">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="150" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Image Source="\Images\Avocado.png" Height="64" Width="64" Margin="0 0 0 5"/>
                                        <TextBlock Text="Регистрация" Foreground="LightGreen" 
                                                        FontSize="36" FontWeight="Bold" HorizontalAlignment="Center">
                                            <TextBlock.Effect>
                                                <DropShadowEffect Color="Black" Direction="180" ShadowDepth="2" BlurRadius="10" Opacity="0.9" />
                                            </TextBlock.Effect>
                                        </TextBlock>
                                    </StackPanel>

                                    <Grid Width="350" HorizontalAlignment="Center" Grid.Row="1">
                                        <TextBlock x:Name="searchPlaceholderReg" Margin="12 0" VerticalAlignment="Center" Foreground="Gray" FontSize="16" FontWeight="Medium" FontFamily="Montserrat"
                                                            IsHitTestVisible="False" Panel.ZIndex="1" Text="Введите логин...">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text.Length, ElementName=txtFilterUsernameReg}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TextBox x:Name="txtFilterUsernameReg" Style="{StaticResource TextBoxStyle}" Height="30"/>

                                    </Grid>

                                    <Grid Width="350" HorizontalAlignment="Center" Grid.Row="2">
                                        <TextBlock x:Name="searchPlaceholder1Reg" Margin="12 0" VerticalAlignment="Center" Foreground="Gray" FontSize="16" FontWeight="Medium" FontFamily="Montserrat"
                                                             IsHitTestVisible="False" Panel.ZIndex="1" Text="Введите почту...">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text.Length, ElementName=txtFilterEmailReg}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TextBox x:Name="txtFilterEmailReg" Style="{StaticResource TextBoxStyle}" Height="30" />

                                    </Grid>


                                    <Grid Width="350" HorizontalAlignment="Center" Grid.Row="3">
                                        <PasswordBox x:Name="txtFilterPasswordReg" PasswordChanged="PasswordBox_PasswordChanged" Style="{StaticResource PasswordBoxStyle}" />
                                    </Grid>

                                    <Button Grid.Row="4" Height="35" Width="200" Style="{StaticResource SecondaryButton}" Content="Зарегистрироваться" VerticalAlignment="Top" Margin="0 5" Click="RegBtn_Click"/>
                                    <Button Grid.Row="4" Background="Transparent" Foreground="#33bb5e" Content="Войти" Width="60" Height="20" BorderThickness="0" FontSize="10" 
                                                    Click="BackAuthor_Click"/>
                                </Grid>
                            </Border>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>

            <Button Style="{StaticResource ExitButtonStyle}"  Height="30" Width="30" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="15" Click="BtnClose_Click" >
                <Image Source="/Images/CloseBtn.png" />
                <Button.Effect>
                    <DropShadowEffect Color="Red" Direction="300" ShadowDepth="2" BlurRadius="5" Opacity="0.4" />
                </Button.Effect>
            </Button>

        </Grid>
    </Border>
</Window>
