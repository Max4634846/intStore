<Window x:Class="intStore.View.InformationPageOrders"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:intStore.View" xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        mc:Ignorable="d"
        Title="InformationPageOrders"
        Height="600" Width="400"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True">
    
    <Border Background="WhiteSmoke" CornerRadius="25">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="35"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="85"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="1">
                <StackPanel>
                    <Image x:Name="ImageProductAdd" Source="\Images\OrdersComlished.png" Width="150"></Image>
                    <TextBlock x:Name="NameProduct" Text="Заказ оформлен" HorizontalAlignment="Center" Margin="10" FontSize="36">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="Black" Direction="180" ShadowDepth="1" BlurRadius="5" Opacity="0.9"/>
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock HorizontalAlignment="Center" Margin="10 5" FontSize="14" TextWrapping="Wrap" Height="53">
                        <Run Text="Все товары в корзине были приобретены. Ваш статус заказа: " />
                        <Run Text="оформлен" Foreground="#33bb5e" />
                    </TextBlock>
                    <TextBlock HorizontalAlignment="Left" Margin="30 0" FontSize="14" TextWrapping="Wrap" Height="20">
                     <Run Text="Курьер с вами свяжиться :) " />
                    </TextBlock>
                    <TextBlock Margin="30 5 0 0" HorizontalAlignment="Left">
                     <Run Text="Способ оплаты : " FontWeight="Bold" FontSize="18" />
                     <Run x:Name="PaymentMethod" Text="Карта" Foreground="#33bb5e" FontSize="16" />
                    </TextBlock>
                    <TextBlock Margin="30 5 0 0" HorizontalAlignment="Left">
                         <Run Text="Имя : " FontWeight="Bold" FontSize="18" />
                         <Run x:Name="UserName" Text="Имя" Foreground="#33bb5e" FontSize="16" />
                    </TextBlock>
                    <TextBlock Margin="30 5 0 0" HorizontalAlignment="Left">
                         <Run Text="Ваш номер телефона : " FontWeight="Bold" FontSize="18" />
                         <Run x:Name="Phone" Text="********" Foreground="#33bb5e" FontSize="16"/>
                    </TextBlock>
                    <TextBlock HorizontalAlignment="Left" Margin="30 5 0 0" FontSize="14" TextWrapping="Wrap">
                        <Run Text="Цена: " FontWeight="Bold" FontSize="18" />
                        <Run x:Name="PriceProduct" Text="100" Foreground="#33bb5e" FontSize="20"/>
                    </TextBlock>
                </StackPanel>
            </Border>
            <WrapPanel Grid.Row="2" Margin="10" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button Content="Ок"  Height="35" Width="180" Style="{StaticResource BtnAddProducts}" Click="OKBTN_Click"/>
            </WrapPanel>


        </Grid>
    </Border>
</Window>
