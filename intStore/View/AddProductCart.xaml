<Window x:Class="intStore.View.AddProductCart"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:intStore.View" xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        mc:Ignorable="d"
        Title="Товар" Height="600" Width="400"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True">

    <Border Background="WhiteSmoke" CornerRadius="25" MouseDown="Border_MouseDown">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="35"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="85"/>
            </Grid.RowDefinitions>
            <Button Click="BtnBack_Click" Style="{StaticResource BtnBack}" Width="150">
                <TextBlock Text="Назад" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="Black" Direction="360" ShadowDepth="1" BlurRadius="5" Opacity="0.9"/>
                    </TextBlock.Effect>
                </TextBlock>
            </Button>
            <Border Grid.Row="1">
                <StackPanel>
                    <Image x:Name="ImageProductAdd" Source="\Images\imagePattern.png" Width="150"></Image>
                    <TextBlock x:Name="NameProduct" Text="Название проудкта" HorizontalAlignment="Left" Margin="10" FontSize="36">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="Black" Direction="360" ShadowDepth="1" BlurRadius="5" Opacity="0.9"/>
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock x:Name="Description" Text="Описание" HorizontalAlignment="Left" Margin="10" FontSize="18">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="Black" Direction="360" ShadowDepth="1" BlurRadius="5" Opacity="0.9"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </StackPanel>
            </Border>
            <Border Grid.Row="2" Background="Gray" CornerRadius="25">
                <WrapPanel Margin="10" VerticalAlignment="Center">
                    <Button Height="35" Width="35" Margin="5" Style="{StaticResource BtnAddProducts}" Click="MinusBtn_Click">
                        <Icon:PackIconMaterial Kind="Minus" Width="5"/>
                    </Button>
                    <TextBox x:Name="CheckNumber" Text="1" Height="35" Width="50" Margin="5" Foreground="White"  Style="{StaticResource TextBoxStyle}" IsReadOnly="True" />
                    <Button Height="35" Width="35" Margin="5 0 55 0" Style="{StaticResource BtnAddProducts}" Click="PlusBtn_Click">
                        <Icon:PackIconMaterial Kind="Plus" Width="5" />
                    </Button>
                    <Button Content="Добавить в корзину"  Height="35" Width="180" Style="{StaticResource BtnAddProducts}" Click="AddProductCart_Click"/>
                </WrapPanel>
            </Border>

        </Grid>
    </Border>
</Window>
