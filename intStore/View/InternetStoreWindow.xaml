<Window x:Class="intStore.View.InternetStoreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:intStore.View"
        mc:Ignorable="d"
        Title="Интернет-Магазин продуктов" Height="850" Width="1250"
        WindowStartupLocation="CenterScreen"
        Icon="\Images\av2.png">
    <Border>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Background="#33bb5e" CornerRadius="0 15 15 0">
                <StackPanel HorizontalAlignment="Center">
                    <StackPanel Margin="0 25 0 0" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Интернет-Магазин" Foreground="White" 
                                        FontSize="24" FontWeight="Bold">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="Black" Direction="320" ShadowDepth="5" BlurRadius="10" Opacity="0.5" />
                                </TextBlock.Effect>
                            </TextBlock>
                    </StackPanel>
                    <WrapPanel Margin="20 10" VerticalAlignment="Center" HorizontalAlignment="Left" Width="250">
                        <TextBlock Text="Имя пользователя" Foreground="White" 
                                    FontSize="18" FontWeight="Bold">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="Black" Direction="320" ShadowDepth="5" BlurRadius="10" Opacity="0.5" />
                            </TextBlock.Effect>
                        </TextBlock>
                        <Button Background="Transparent" BorderBrush="Transparent" Margin="10 0">
                            <Image Source="\Images\BaskedShop.png" Height="25" Width="25"/>
                        </Button>
                    </WrapPanel>
                    
                    <StackPanel Margin="0 5">
                        <Button Content="Продукты" Foreground="White" 
                                         FontSize="18" Height="34"  Background="#33bb5e" Width="250" BorderBrush="Transparent" Click="BtnProduct_Click">
                                <Button.Effect>
                                    <DropShadowEffect Color="Gray" Direction="180" ShadowDepth="1" BlurRadius="5" Opacity="0.9" />
                                </Button.Effect>
                            
                        </Button>
                    </StackPanel>
                    <StackPanel>
                        <Button Content="Отчеты" Foreground="White" 
                     FontSize="18" Height="34"  Background="#33bb5e" Width="250" BorderBrush="Transparent" Click="ReportBtn_Click">
                            <Button.Effect>
                                <DropShadowEffect Color="Gray" Direction="180" ShadowDepth="1" BlurRadius="5" Opacity="0.9" />
                            </Button.Effect>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TabControl Grid.Column="1" Background="Transparent" BorderBrush="Transparent" Margin="5" x:Name="mainTabControl">
                <TabItem Header="Продукты" BorderBrush="Transparent" Visibility="Collapsed"  x:Name="Product" >
                    <Grid Margin="20 0 0 0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="55" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Список продуктов" FontSize="24" Margin="10" HorizontalAlignment="Center">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="White" Direction="360" ShadowDepth="1" BlurRadius="5" Opacity="0.9" />
                            </TextBlock.Effect>
                        </TextBlock>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl Name="ItemsList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderThickness="1" BorderBrush="#33bb5e" Margin="5" Padding="5" CornerRadius="35" Width="300">
                                            <Grid Margin="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Image Source="{Binding ImageProduct}" Stretch="Uniform" Height="100" Width="100" HorizontalAlignment="Left" Margin="0 0 10 0" Grid.Column="0"/>

                                                <Grid Grid.Column="1">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <TextBlock FontSize="18" Grid.Row="0" Margin="5">
                                                        <Run Text="{Binding NameProduct}"/>
                                                    </TextBlock>
                                                    <TextBlock FontSize="16" Grid.Row="1" Margin="5">
                                                        <Run Text="Дата: "/>
                                                        <Run Text="{Binding DateProduct}"/>
                                                    </TextBlock>
                                                    <TextBlock FontSize="14" Grid.Row="2" Margin="5">
                                                        <Run Text="Количество: "/>
                                                        <Run Text="{Binding Quantity}"/>
                                                    </TextBlock>
                                                    <TextBlock Grid.Row="3" Margin="5">
                                                        <Run Text="Цена: "/>
                                                        <Run Text="{Binding Price}"/>
                                                    </TextBlock>
                                                    <TextBlock Grid.Row="4" Margin="5">
                                                        <Run Text="Вес: "/>
                                                        <Run Text="{Binding Weight}"/>
                                                    </TextBlock>
                                                    <Button Content="Добавить" Grid.Row="5" Style="{StaticResource BtnAddProducts}"/>
                                                </Grid>

                                                <!--<TextBlock Text="{Binding Description}" Width="250" TextWrapping="Wrap" Grid.Column="2" Margin="10"/>-->
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>


                        </ScrollViewer>
                    </Grid>
                   

                </TabItem>
                <TabItem Header="Отчеты" BorderBrush="Transparent" Visibility="Collapsed" x:Name="Report">
                    
                    <Image x:Name="testImage" Stretch="UniformToFill"  /> 
                    
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</Window>
