<Window x:Class="intStore.View.InternetStoreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:local="clr-namespace:intStore.View"
        mc:Ignorable="d"
        Title="Интернет-Магазин продуктов" Height="850" Width="1280"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Icon="\Images\Avocado.png">

    <Border CornerRadius="35" Background="White" MouseDown="Border_MouseDown">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Background="White" Margin="10 11" CornerRadius="15 15 15 15">
                <StackPanel HorizontalAlignment="Center">
                    
                    <WrapPanel Margin="0 25 0 0" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Интернет-Магазин" Foreground="Black" FontSize="24" FontWeight="Bold"/>
                        <Button  Background="Transparent" BorderBrush="Transparent" Style="{StaticResource BtnCartStyle}" Click="BtnCart_Click">
                            <StackPanel>
                                <Image Source="\Images\BaskedShop.png" Height="35" Width="35"/>
                                <TextBlock x:Name="btnCart" Foreground="#33bb5e" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-45,-1,0"/>
                            </StackPanel>
                            <Button.Effect>
                                <DropShadowEffect Color="Black" Direction="90" ShadowDepth="1" BlurRadius="2" Opacity="0.5" />
                            </Button.Effect>
                        </Button>
                    </WrapPanel>
                    
                    <WrapPanel Margin="0 0 0 5" VerticalAlignment="Center" HorizontalAlignment="Left" Width="250">
                        <TextBlock Foreground="Black" FontSize="18" FontWeight="Bold">
                            <Run Text="Пользователь :" />
                            <Run x:Name="NameUserTextBlock" Text="Имя" />
                        </TextBlock>
                    </WrapPanel>

                    <WrapPanel Margin="0 0 0 10" VerticalAlignment="Center" HorizontalAlignment="Left" Width="250">
                        <TextBlock Foreground="Black" FontSize="18" FontWeight="Bold">
                            <Run Text="Сумма :" />
                            <Run x:Name="Cost" Text="100 руб." Foreground="#33bb5e" FontSize="16" />
                        </TextBlock>
                    </WrapPanel>

                    <StackPanel>
                        
                        <Button Foreground="White" FontSize="18" Height="34"  Background="#33bb5e" BorderBrush="Transparent" Click="BtnMain_Click" Style="{StaticResource BtnAddProducts}" Margin="0 5">
                            <Button.Effect>
                                <DropShadowEffect Color="Gray" Direction="180" ShadowDepth="1" BlurRadius="5" Opacity="0.9" />
                            </Button.Effect>
                            <TextBlock Text="Главная">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="Gray" Direction="180" ShadowDepth="1" BlurRadius="5" Opacity="0.9" />
                                </TextBlock.Effect>
                            </TextBlock>
                        </Button>

                        <Button Foreground="White" FontSize="18" Height="34"  Background="#33bb5e" BorderBrush="Transparent" Click="BtnOrders_Click" Style="{StaticResource BtnAddProducts}" Margin="0 5">
                            <Button.Effect>
                                <DropShadowEffect Color="Gray" Direction="180" ShadowDepth="1" BlurRadius="5" Opacity="0.9" />
                            </Button.Effect>
                            <TextBlock Text="Доставки">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="Gray" Direction="180" ShadowDepth="1" BlurRadius="5" Opacity="0.9" />
                                </TextBlock.Effect>
                            </TextBlock>
                        </Button>

                        <Button Foreground="White"  FontSize="18" Height="34"  Background="#33bb5e" BorderBrush="Transparent" Click="BtnProduct_Click" Style="{StaticResource BtnAddProducts}" Margin="0 5">
                            <Button.Effect>
                                <DropShadowEffect Color="Gray" Direction="180" ShadowDepth="1" BlurRadius="5" Opacity="0.9" />
                            </Button.Effect>
                            <TextBlock Text="Продукты">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="Gray" Direction="180" ShadowDepth="1" BlurRadius="5" Opacity="0.9" />
                                </TextBlock.Effect>
                            </TextBlock>
                        </Button>

                        <Button Foreground="White" FontSize="18" Height="34"  Background="#33bb5e" BorderBrush="Transparent" Click="BtnCloseApp_Click" Style="{StaticResource BtnAddProducts}" Margin="0 5">
                            <Button.Effect>
                                <DropShadowEffect Color="Gray" Direction="180" ShadowDepth="1" BlurRadius="5" Opacity="0.9" />
                            </Button.Effect>
                            <TextBlock Text="Выйти">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="Gray" Direction="180" ShadowDepth="1" BlurRadius="10" Opacity="0.9" />
                                </TextBlock.Effect>
                            </TextBlock>
                        </Button>
                        
                    </StackPanel>
                </StackPanel>
            </Border>

            <TabControl Background="Transparent" BorderBrush="Transparent" Margin="285,5,15,5" x:Name="mainTabControl" Grid.ColumnSpan="2" >
                <TabItem Header="Главная" BorderBrush="Transparent" Visibility="Collapsed"  x:Name="MainPage">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="150"/>
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="Linen" CornerRadius="15" Margin="0 25 0 0">
                            
                            <WrapPanel HorizontalAlignment="Right" Margin="-2 -5">
                                <Button Content="Курьер" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="24" Foreground="White" Style="{StaticResource BtnAddProducts}" Margin="0 0 5 0" />
                                <Button Content="Самовывоз" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="24" Foreground="White" Style="{StaticResource BtnAddProducts}"/>
                            </WrapPanel>

                        </Border>
                        
                        <TextBlock Grid.Row="1" Text="Каталог" FontSize="36" />

                        <Border Grid.Row="1" Background="Linen" Margin="0 50" CornerRadius="15">
                            <ListView Grid.Row="1" BorderBrush="Transparent" x:Name="CatalogList" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="Linen" CornerRadius="5" Margin="5">
                                            <Border.Effect>
                                                <DropShadowEffect Color="Gray" Direction="180" ShadowDepth="1" BlurRadius="5" Opacity="0.9" />
                                            </Border.Effect>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <Image Source="{Binding ImageProduct}" Width="100" Height="100" Margin="5" Grid.Column="0"/>
                                                <StackPanel Orientation="Vertical" VerticalAlignment="Center" Grid.Column="1" Margin="10,0">
                                                    <TextBlock Text="{Binding NameProduct}" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>
                                                    <TextBlock >
                                                        <Run Text="Количество: " />
                                                        <Run Text="{Binding Quantity}" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <Button Content="Купить" Height="30" HorizontalAlignment="Right" 
                                                    VerticalAlignment="Center" Margin="5" Style="{StaticResource BtnAddProducts}" Grid.Column="1" Click="BtnBuy_Click"/>
                                                <Button Content="Удалить" Height="30" HorizontalAlignment="Right" 
                                                    VerticalAlignment="Center" Margin="5" Style="{StaticResource BtnDeleteProducts}" Grid.Column="2" Click="BtnDeleteProductCart_Click" CommandParameter="{Binding}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="Корзина" BorderBrush="Transparent" Visibility="Collapsed"  x:Name="Cart">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="45" />
                            <RowDefinition Height="750" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Корзина" HorizontalAlignment="Right" Margin="10 0" FontSize="36"/>
                        
                        <TextBlock x:Name="searchCart" Margin="26 0" VerticalAlignment="Center" Foreground="Gray" IsHitTestVisible="False" Panel.ZIndex="1" Text="Найти...">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text.Length, ElementName=txtSearchCart}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        
                        <TextBox x:Name="txtSearchCart" Margin="15,0" HorizontalAlignment="Left" Style="{StaticResource TextBoxStyle}" Height="40" Width="250" TextChanged="txtSearchCart_TextChanged"/>

                        <ListView Grid.Row="1" BorderBrush="Transparent" x:Name="CartList" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="Linen" CornerRadius="5" Margin="5">
                                        <Border.Effect>
                                            <DropShadowEffect Color="Gray" Direction="180" ShadowDepth="1" BlurRadius="5" Opacity="0.9" />
                                        </Border.Effect>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Image Source="{Binding ImageProduct}" Width="100" Height="100" Margin="5" Grid.Column="0"/>
                                            <StackPanel Orientation="Vertical" VerticalAlignment="Center" Grid.Column="1" Margin="10,0">
                                                <TextBlock Text="{Binding NameProduct}" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>
                                                <TextBlock >
                                                    <Run Text="Количество: " />
                                                    <Run Text="{Binding Quantity}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <Button Content="Купить" Height="30" HorizontalAlignment="Right" 
                                                    VerticalAlignment="Center" Margin="5" Style="{StaticResource BtnAddProducts}" Grid.Column="1" Click="BtnBuy_Click"/>
                                            <Button Content="Удалить" Height="30" HorizontalAlignment="Right" 
                                                    VerticalAlignment="Center" Margin="5" Style="{StaticResource BtnDeleteProducts}" Grid.Column="2" Click="BtnDeleteProductCart_Click" CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </TabItem>

                <TabItem Header="Продукты" BorderBrush="Transparent" Visibility="Collapsed"  x:Name="Product" >
                    <Grid Margin="20 0 0 0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="66" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Список продуктов" FontSize="36" Margin="10" HorizontalAlignment="Right"/>

                        <TextBlock x:Name="searchProduct" Margin="26 0" VerticalAlignment="Center" Foreground="Gray" IsHitTestVisible="False" Panel.ZIndex="1" Text="Найти...">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text.Length, ElementName=txtSearchProduct}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBox x:Name="txtSearchProduct" Margin="15,0" HorizontalAlignment="Left" Style="{StaticResource TextBoxStyle}" Height="40" Width="250" TextChanged="txtSearchProduct_TextChanged"/>

                        <ScrollViewer VerticalScrollBarVisibility="Hidden" Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl Name="ItemsList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="5" Padding="5" CornerRadius="25" Width="300" Background="Linen">
                                            <Border.Effect>
                                                <DropShadowEffect Color="Gray" Direction="360" ShadowDepth="1" BlurRadius="5" Opacity="0.9" />
                                            </Border.Effect>
                                            <Grid Margin="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Image Source="{Binding ImageProduct}" Stretch="Uniform" Height="100" Width="100" HorizontalAlignment="Left" Margin="0 0 10 0" Grid.Column="0"/>

                                                <Grid Grid.Column="1">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <TextBlock FontSize="18" Grid.Row="0" Margin="5" FontWeight="Bold">
                                                        <Run Text="{Binding NameProduct}"/>
                                                    </TextBlock>
                                                    <TextBlock FontSize="14" Grid.Row="1" Margin="5">
                                                        <Run Text="Дата: "/>
                                                        <Run Text="{Binding DateProduct, StringFormat='dd/MM/yyyy'}"/>
                                                    </TextBlock>
                                                    <TextBlock FontSize="14" Grid.Row="2" Margin="5">
                                                        <Run Text="Количество: "/>
                                                        <Run Text="{Binding Quantity}"/>
                                                        <Run Text="шт."/>
                                                    </TextBlock>
                                                    <TextBlock Grid.Row="3" Margin="5">
                                                        <Run Text="Цена за 1 кг: "/>
                                                        <Run Text="{Binding Price}"/>
                                                        <Run Text="руб."/>
                                                    </TextBlock>
                                                    <TextBlock Grid.Row="4" Margin="5">
                                                        <Run Text="Вес: "/>
                                                        <Run Text="{Binding Weight}"/>
                                                        <Run Text="грамм."/>
                                                    </TextBlock>
                                                    <Button Grid.Row="5" Style="{StaticResource BtnAddProducts}" Width="40" HorizontalAlignment="Right" Click="AddProduct_Click" CommandParameter="{Binding}">
                                                        <Icon:PackIconMaterial Kind="Plus" VerticalAlignment="Center" HorizontalAlignment="Center" Width="10"/>
                                                    </Button>

                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <TabItem Header="Доставки" BorderBrush="Transparent" Visibility="Collapsed" x:Name="Orders">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="45" />
                            <RowDefinition Height="750" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Доставки" HorizontalAlignment="Right" Margin="10 0" FontSize="36"/>

                        <TextBlock x:Name="searchOrder" Margin="26 0" VerticalAlignment="Center" Foreground="Gray" IsHitTestVisible="False" Panel.ZIndex="1" Text="Найти...">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text.Length, ElementName=txtSearchOrders}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBox x:Name="txtSearchOrders" Margin="15,0" HorizontalAlignment="Left" Style="{StaticResource TextBoxStyle}" Height="40" Width="250" TextChanged="txtSearchCart_TextChanged"/>

                        <ListView Grid.Row="1" BorderBrush="Transparent" x:Name="OrdersList" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="Linen" CornerRadius="5" Margin="5">
                                        <Border.Effect>
                                            <DropShadowEffect Color="Gray" Direction="180" ShadowDepth="1" BlurRadius="5" Opacity="0.9" />
                                        </Border.Effect>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Image Source="{Binding ImageProduct}" Width="100" Height="100" Margin="5" Grid.Column="0"/>
                                            <StackPanel Orientation="Vertical" VerticalAlignment="Center" Grid.Column="1" Margin="10,0">
                                                <TextBlock Text="{Binding NameProduct}" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>
                                                <TextBlock >
                                                    <Run Text="Количество: " />
                                                    <Run Text="{Binding Quantity}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <Button Content="Купить" Height="30" HorizontalAlignment="Right" 
                                                    VerticalAlignment="Center" Margin="5" Style="{StaticResource BtnAddProducts}" Grid.Column="1" Click="BtnBuy_Click"/>
                                            <Button Content="Удалить" Height="30" HorizontalAlignment="Right" 
                                                    VerticalAlignment="Center" Margin="5" Style="{StaticResource BtnDeleteProducts}" Grid.Column="2" Click="BtnDeleteProductCart_Click" CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </TabItem>
                
            </TabControl>
        </Grid>
    </Border>
</Window>
