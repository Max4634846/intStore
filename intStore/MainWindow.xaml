<Window x:Class="intStore.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:intStore"
        mc:Ignorable="d"
        Title="Login" Height="650" Width="850"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStartupLocation="CenterScreen"
        Icon="\Images\av2.png">

    <Border Background="AliceBlue" CornerRadius="35" MouseDown="Border_MouseDown">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Background="#33bb5e" CornerRadius="35 0 0 35">
                <Grid>
                    <Grid.ColumnDefinitions >
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions >
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>


                    <Ellipse Width="300" Height="300">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="\Images\LoginFon.jpg" Stretch="UniformToFill" />
                        </Ellipse.Fill>
                    </Ellipse>

                </Grid>
            </Border>
            <Border Grid.Column="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="650" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TabControl Background="Transparent" BorderBrush="Transparent" Grid.Row="1" Margin="30" x:Name="mainTabControl">
                        <TabItem Header="Авторизация" VerticalAlignment="Center" HorizontalAlignment="Center" x:Name="Author" Visibility="Collapsed">
                            <Border Background="AliceBlue" CornerRadius="15">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="200" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left" Grid.ColumnSpan="2" Margin="37,0,0,0">
                                        <Image Source="\Images\av2.png" Height="64" Width="64" Margin="0 0 0 5"/>
                                        <TextBlock Text="Интернет-Магазин" Foreground="White" 
                                                    FontSize="36" FontWeight="Bold">
                                            <TextBlock.Effect>
                                                <DropShadowEffect Color="Black" Direction="320" ShadowDepth="5" BlurRadius="10" Opacity="0.5" />
                                            </TextBlock.Effect>
                                        </TextBlock>

                                        <TextBlock VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0 10"
                                                    Foreground="White" FontSize="14" Text="Свежесть и качество к вашему столу каждый день!">
                                            <TextBlock.Effect>
                                                <DropShadowEffect Color="Black" Direction="320" ShadowDepth="1" BlurRadius="2" Opacity="1" />
                                            </TextBlock.Effect>
                                        </TextBlock>
                                    </StackPanel>

                                    <Grid Width="350" HorizontalAlignment="Left" Grid.Row="1" Grid.ColumnSpan="2" Margin="27,0,0,90" Grid.RowSpan="2">
                                        <TextBlock x:Name="searchPlaceholder" Margin="15 0" VerticalAlignment="Center" Foreground="Gray" 
                                                            IsHitTestVisible="False" Panel.ZIndex="1" Text="Логин...">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text.Length, ElementName=txtFilterUsername}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TextBox x:Name="txtFilterUsername" Style="{StaticResource textboxUsername}" Height="40"/>

                                    </Grid>

                                    <Grid Width="350" HorizontalAlignment="Left" Grid.Row="2" Grid.ColumnSpan="2" Margin="27,0,0,0">
                                        <TextBlock x:Name="searchPlaceholder1" Margin="15 0" VerticalAlignment="Center" Foreground="Gray" 
                                                            IsHitTestVisible="False" Panel.ZIndex="1" Text="Пароль...">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text.Length, ElementName=txtFilterPassword}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TextBox x:Name="txtFilterPassword" Style="{StaticResource textboxPassword}" Height="40"/>

                                    </Grid>


                                    <Button Grid.Row="3" Height="35" Width="200" Style="{StaticResource SecondaryButton}" Content="Войти" Click="LoginBtn_Click" Grid.ColumnSpan="2"/>
                                    <Button Grid.Row="3" Content="Регистрация" Background="Transparent" FontSize="10"  Foreground="#33bb5e" BorderThickness="0" Margin="0,68,0,1" Width="60" Click="NextReg_Click"/>
                                </Grid>
                            </Border>
                        </TabItem>
                        <TabItem Header="Регистрация" Background="AliceBlue" VerticalAlignment="Center" HorizontalAlignment="Center" x:Name="Reg" Visibility="Collapsed" >
                            <Border Background="AliceBlue" CornerRadius="15">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="150" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Image Source="\Images\av2.png" Height="64" Width="64" Margin="0 0 0 5"/>
                                        <TextBlock Text="Регистрация" Foreground="White" 
                                                FontSize="36" FontWeight="Bold" HorizontalAlignment="Center">
                                            <TextBlock.Effect>
                                                <DropShadowEffect Color="Black" Direction="320" ShadowDepth="5" BlurRadius="10" Opacity="0.5" />
                                            </TextBlock.Effect>
                                        </TextBlock>
                                    </StackPanel>

                                    <Grid Width="350" HorizontalAlignment="Center" Grid.Row="1">
                                        <TextBlock x:Name="searchPlaceholderReg" Margin="15 0" VerticalAlignment="Center" Foreground="Gray" 
                                IsHitTestVisible="False" Panel.ZIndex="1" Text="Логин...">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text.Length, ElementName=txtFilterUsernameReg}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TextBox x:Name="txtFilterUsernameReg" Style="{StaticResource textboxUsername}" Height="40"/>

                                    </Grid>
                                    <Grid Width="350" HorizontalAlignment="Center" Grid.Row="2">
                                        <TextBlock x:Name="searchPlaceholder1Reg" Margin="15 0" VerticalAlignment="Center" Foreground="Gray" 
                                                     IsHitTestVisible="False" Panel.ZIndex="1" Text="Пароль...">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text.Length, ElementName=txtFilterEmailReg}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TextBox x:Name="txtFilterEmailReg" Style="{StaticResource textboxPassword}" Height="40"/>

                                    </Grid>


                                    <Grid Width="350" HorizontalAlignment="Center" Grid.Row="3">
                                        <TextBlock x:Name="searchPlaceholder1EmailReg" Margin="15 0" VerticalAlignment="Center" Foreground="Gray" 
                                            IsHitTestVisible="False" Panel.ZIndex="1" Text="Почта...">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text.Length, ElementName=txtFilterPasswordReg}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TextBox x:Name="txtFilterPasswordReg" Style="{StaticResource textboxPassword}" Height="40"/>

                                    </Grid>


                                    <Button Grid.Row="4" Height="35" Width="200" Style="{StaticResource SecondaryButton}" Content="Зарегистрироваться" VerticalAlignment="Top" Margin="0 5" Click="RegBtn_Click"/>
                                    <Button Grid.Row="4" Background="Transparent" Foreground="#33bb5e" Content="Войти" Width="60" Height="20" BorderThickness="0" FontSize="10" 
                                            Click="BackAuthor_Click"/>
                                </Grid>
                            </Border>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
            <Button Style="{StaticResource ExitButtonStyle}"  Height="30" Width="30" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="15" Click="BtnClose_Click" >
                <Image Source="/Images/CloseBtn.png" />
                <Button.Effect>
                    <DropShadowEffect Color="Red" Direction="300" ShadowDepth="2" BlurRadius="5" Opacity="0.4" />
                </Button.Effect>
            </Button>
        </Grid>
    </Border>
</Window>
